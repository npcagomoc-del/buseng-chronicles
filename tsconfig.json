{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true, "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true, "verbatimModuleSyntax": true,
    "isolatedModules": true, "skipLibCheck": true, "noEmit": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "types": ["vite/client", "bun"]
  },
  "include": ["src", "tests"]
}
